<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13+ 弹不弹通知取决于这个运行时权限 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Android 11+ 包可见性：不声明的话 CustomTabsClient 找不到任何浏览器，
         resolveActivity 也永远返回 null，第三方登录会被误判成"设备没有浏览器"而落到 WebView。 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
    </queries>

    <!-- 不参与系统备份：备份会把 prefs 里的 JWT、草稿和缓存 DB 一起带到新设备。
         比起逐条排除（以后新增敏感文件容易漏），直接整体关闭更稳；
         dataExtractionRules 再把 Android 12+ 的设备迁移也显式排除。 -->
    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:networkSecurityConfig="@xml/network_security_config"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.OtsMail">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 第三方登录回调：浏览器（Custom Tabs）把 code/state 带回 App -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="otsmail"
                    android:host="oauth"
                    android:pathPrefix="/callback" />
            </intent-filter>
        </activity>

        <!-- FCM：onNewToken / onMessageReceived 都走这个子类 -->
        <service
            android:name=".push.OtsMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- 通知栏快捷操作（标记已读/删除/快速回复）：只由本 App 的 PendingIntent 触发 -->
        <receiver
            android:name=".push.NotificationActionReceiver"
            android:exported="false" />

        <!-- 服务端走 data 消息时才用得上这两个兜底（通知栏小图标/渠道） -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ot_mail" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="ot_mail_push" />
    </application>
</manifest>
