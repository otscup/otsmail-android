<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 扫码登录：运行时申请，只用于识别网页端登录二维码 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- 没有相机的设备（部分平板/模拟器）也要能安装，扫码入口内部再提示 -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <!-- Android 13+ 弹不弹通知取决于这个运行时权限 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 新邮件通知渠道默认开启震动；不给 VIBRATE 系统会静默忽略震动 -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 外部邮箱 IMAP IDLE 前台服务：只在拿不到 FCM token 的设备上启动 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- 定时发送：重启后要把闹钟重新排上，否则设备一重启定时邮件就丢 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 无 GMS 机型引导把本 App 加入「电池优化」白名单：否则系统会在后台冻结 IMAP IDLE -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Android 11+ 包可见性：不声明的话 CustomTabsClient 找不到任何浏览器，
         resolveActivity 也永远返回 null，第三方登录会被误判成"设备没有浏览器"而落到 WebView。 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
    </queries>

    <!-- 不参与系统备份：备份会把 prefs 里的 JWT、草稿和缓存 DB 一起带到新设备。
         比起逐条排除（以后新增敏感文件容易漏），直接整体关闭更稳；
         dataExtractionRules 再把 Android 12+ 的设备迁移也显式排除。 -->
    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:networkSecurityConfig="@xml/network_security_config"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.OtsMail">
        <!-- 长按图标「扫一扫」：静态快捷方式，落到 MainActivity 的 otsmail://qr 深链 -->
        <meta-data
            android:name="android.app.shortcuts"
            android:resource="@xml/shortcuts" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 第三方登录回调：浏览器（Custom Tabs）把 code/state 带回 App -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="otsmail"
                    android:host="oauth"
                    android:pathPrefix="/callback" />
            </intent-filter>
            <!-- 扫码登录入口：长按图标快捷方式 / 外部唤起 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="otsmail"
                    android:host="qr" />
            </intent-filter>
        </activity>

        <!-- FCM：onNewToken / onMessageReceived 都走这个子类 -->
        <service
            android:name=".push.OtsMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- 外部邮箱 IMAP IDLE：同进程前台服务，无 GMS 设备上保持连接/重连；
             START_STICKY 让进程被杀后系统能重新拉起（配额见 ExtIdleService 注释） -->
        <service
            android:name=".push.ExtIdleService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:stopWithTask="false" />

        <!-- 通知栏快捷操作（标记已读/删除/快速回复）：只由本 App 的 PendingIntent 触发 -->
        <receiver
            android:name=".push.NotificationActionReceiver"
            android:exported="false" />

        <!-- 通知栏「复制验证码」：透明、无动画、无历史，复制完立即 finish -->
        <activity
            android:name=".push.CopyCodeActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.OtsMail.CopyCode" />

        <!-- 定时发送到点触发：只接本 App 的 PendingIntent（exported=false） -->
        <receiver
            android:name=".schedule.ScheduledSendReceiver"
            android:exported="false" />

        <!-- 开机/装包/改时间/改时区后恢复定时任务；系统广播因此必须 exported=true -->
        <receiver
            android:name=".schedule.ScheduledSendRescheduleReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- 稍后提醒到点触发与通知栏快捷操作：只接本 App 的 PendingIntent -->
        <receiver
            android:name=".schedule.SnoozeReceiver"
            android:exported="false" />
        <receiver
            android:name=".schedule.SnoozeActionReceiver"
            android:exported="false" />

        <!-- 开机/装包/改时间/改时区后恢复稍后提醒；系统广播因此必须 exported=true -->
        <receiver
            android:name=".schedule.SnoozeRescheduleReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- 服务端走 data 消息时才用得上这两个兜底（通知栏小图标/渠道）。
             渠道 id 必须指向 ensureChannel 里真正会创建、且不会被删除的那条，否则 FCM 找不到默认渠道 -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notif_at" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="ot_mail_push_sv" />
    </application>
</manifest>
